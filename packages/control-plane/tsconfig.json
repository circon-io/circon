{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"]
  },
  // Worker code only. Tests and the provision script are Node-land — they use
  // node: builtins that Workers types deliberately do not declare, and they run
  // through `node --test` rather than through tsc.
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
