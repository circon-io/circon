{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circon-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Deployed to a custom domain, not workers.dev. The domain itself is passed
  // as `--domain` at deploy time so it differs per environment; setting this
  // false is what stops wrangler demanding a workers.dev subdomain.
  // The API. Its hostname goes into DASHBOARD/CLI config as CONTROL_PLANE_URL.
  "workers_dev": false,

  "durable_objects": {
    "bindings": [{ "name": "RUNNER", "class_name": "RunnerDO" }]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed so the DO can keep its own log buffer cheaply and
      // hibernate between heartbeats.
      "new_sqlite_classes": ["RunnerDO"]
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "circon",
      // Injected by scripts/provision.mjs — a D1 database cannot be declared
      // into existence, so the deploy workflow creates it and writes the id.
      "database_id": "PLACEHOLDER_D1_ID",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    // A well-known endpoint serving public keys — public by design, so a var.
    "CLERK_JWKS_URL": "",
    "CLERK_ISSUER": "",
    "ENROLL_TOKEN_TTL_MINUTES": "30",
    // The dashboard Worker's origin. Only this origin may call the API from a
    // browser; runners use bearer tokens and are unaffected by CORS.
    "DASHBOARD_ORIGIN": "",
    // Stripe price id for the Pro plan. Test and live mode differ, so this is
    // set per environment rather than hard-coded in plans.ts.
    "STRIPE_PRICE_PRO": ""
  }

  // Secrets, set by the deploy workflow with `wrangler secret put`:
  //   CLERK_SECRET_KEY        read and write org billing metadata
  //   RUNNER_SECRET_PEPPER    peppers runner-token hashes
  //   STRIPE_SECRET_KEY       create checkout and portal sessions
  //   STRIPE_WEBHOOK_SECRET   verify webhook signatures
}
