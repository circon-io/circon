{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circon-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-01-01",
  // Required by OpenNext: Next's server code expects Node built-ins.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // Deployed to a custom domain, not workers.dev. The domain itself is passed
  // as `--domain` at deploy time so it differs per environment; setting this
  // false is what stops wrangler demanding a workers.dev subdomain.
  // The dashboard. Its hostname is what DASHBOARD_ORIGIN must match on the API.
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // The control-plane Worker. Same zone in production, so no CORS.
    "NEXT_PUBLIC_CONTROL_PLANE_URL": "https://circon-control-plane.workers.dev"
  }
  // Secrets, set by the deploy workflow:
  //   CLERK_SECRET_KEY
  // Variables set at deploy time:
  //   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
}
