{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "circon-website",
  // Runs for `/` only (see run_worker_first): it picks a language and
  // redirects. Every other request is a static file and never reaches it.
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",

  // Deployed to a custom domain, passed as `--domain` at deploy time, like the
  // dashboard. False stops wrangler demanding a workers.dev subdomain.
  "workers_dev": false,
  "assets": {
    // `next build` with `output: 'export'`.
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // out/404.html, rendered from app/global-not-found.tsx.
    "not_found_handling": "404-page",
    "run_worker_first": ["/"]
  }
}
