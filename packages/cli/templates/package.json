{
  "name": "monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --parallel --recursive dev",
    "build": "pnpm --recursive build",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "deploy": "pnpm --filter ./services/api run deploy && pnpm --filter ./apps/web run deploy"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
