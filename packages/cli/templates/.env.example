# Copy to .env and fill in. Never commit .env.
# For the API under `wrangler dev`, the same values go in services/api/.dev.vars.

# --- Clerk (auth) -----------------------------------------------------------
# The app: Clerk dashboard → API Keys → Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# The API verifies session tokens against these (Clerk → API Keys → JWKS URL)
CLERK_JWKS_URL=
CLERK_ISSUER=
# Clerk → Webhooks → your endpoint → Signing secret (whsec_…)
CLERK_WEBHOOK_SECRET=

# --- The API ----------------------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:8787
# Comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8081

# Only for hosts other than Cloudflare (Node, Lambda, Vercel, Netlify): libSQL
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# --- Cloudflare (deploys) ---------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Sentry (production only; leave blank in development) -------------------
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
