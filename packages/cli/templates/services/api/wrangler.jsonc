{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true }
  // Secrets are set with `wrangler secret put`, never committed here.
  // Bindings (D1, KV, R2) go in this file once they exist.
}
